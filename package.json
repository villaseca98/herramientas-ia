{
  "name": "afiliacion-ia-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web de afiliados de herramientas de IA en español, con pipeline de contenido automatizado.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --borradores",
    "dev": "node scripts/build.mjs --borradores && node scripts/serve.mjs",
    "detectar": "node scripts/detectar.mjs",
    "redactar": "node scripts/redactar.mjs",
    "enlaces": "node scripts/enlaces.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "redes": "node scripts/redes.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0",
    "marked": "^16.0.0",
    "pdfjs-dist": "^5.7.284",
    "yaml": "^2.8.0"
  }
}
